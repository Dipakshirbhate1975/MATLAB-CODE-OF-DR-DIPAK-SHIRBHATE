ROUTE clock4.fraction_changed TO colorpath4.set_fraction
ROUTE colorpath4.value_changed TO color2.set_emissiveColor
ROUTE touch3.touchTime TO code3.set_light
ROUTE code3.value TO light0.set_on
ROUTE touch4.touchTime TO code4.set_light
