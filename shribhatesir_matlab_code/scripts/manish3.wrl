DEF Import_DeskLamp_wrl0 Group {
	children [ 
	    NavigationInfo {
		    headlight	TRUE
		    speed	1
		    type	[ "EXAMINE",
				      "ANY" ]
		    visibilityLimit	0
	    }

	    Viewpoint {
		    fieldOfView	0.785
		    jump	TRUE
		    position	0 0.1 1
		    description	"DeskLamp"
	    }

	    Group {
		    children [ 
			DEF movelamp PlaneSensor {
			}

			DEF lamp Transform {
				translation	0 0 0
				children [ 
				    Shape {
					    appearance	Appearance {
						    material	DEF color Material {
							    ambientIntensity	0.2
							    diffuseColor	0.8 0 0.6
						    }

					    }

					    geometry	Cylinder {
						    height	0.01
						    radius	0.1
					    }

				    }

				    Group {
					    children [ 
						DEF movefirstarm SphereSensor {
						}

						DEF firstarm Transform {
							translation	0 0.15 0
							rotation	-1 0 0  0.7
							center	0 -0.15 0
							children [ 
							    DEF lamparm Shape {
								    appearance	Appearance {
									    material	USE color 
								    }

								    geometry	Cylinder {
									    height	0.3
									    radius	0.01
								    }

							    }

							    Group {
								    children [ 
									DEF movesecondarm SphereSensor {
									}

									DEF secondarm Transform {
										translation	0 0.3 0
										rotation	1 0 0  1.9
										center	0 -0.15 0
										children [ 
										    USE lamparm 
										    Group {
											    children [ 
												DEF movelampshade SphereSensor {
												}

												DEF lampshade Transform {
													translation	0 0.075 0
													rotation	-1 0 0  1.25
													center	0 0.075 0
													children [ 
													    Shape {
														    appearance	Appearance {
															    material	USE color 
														    }

														    geometry	Cone {
															    bottomRadius	0.12
															    height	0.15
															    bottom	FALSE
														    }

													    }

													    Transform {
														    translation	0 -0.05 0
														    children [ 
															Shape {
																appearance	Appearance {
																	material	DEF color2 Material {
																		ambientIntensity	0.2
																		diffuseColor	0.4 0.4 0.4
																		emissiveColor	0 0 0
																	}

																}

																geometry	Sphere {
																	radius	0.05
																}

															}

															DEF clock1 TimeSensor {
																cycleInterval	0.5
																loop	FALSE
																startTime	-1
															}

															DEF colorpath1 ColorInterpolator {
																key	[ 0, 1 ]
																keyValue	[ 0.4 0.4 0.4,
																		  1 1 0 ]
															}

															DEF colorpath2 ColorInterpolator {
																key	[ 0, 1 ]
																keyValue	[ 1 1 0,
																		  0.4 0.4 0.4 ]
															}

															DEF clock2 TimeSensor {
																cycleInterval	0.5
																loop	FALSE
																startTime	-1
															}

															DEF dad_light Transform {
																rotation	-1 0 0  0.96
																children DEF light SpotLight {
																	ambientIntensity	0.8
																	attenuation	1 0 0
																	beamWidth	0.393
																	color	1 1 0
																	cutOffAngle	0.785
																	intensity	1
																	location	0 0 0
																	on	FALSE
																	radius	20
																}
															}
														    ]
													    }
													]
												}
											    ]
										    }
										]
									}
								    ]
							    }
							]
						}
					    ]
				    }

				    DEF button1 Transform {
					    translation	-0.02 0.015 0.05
					    children DEF button1group Group {
						    children [ 
							Shape {
								appearance	Appearance {
									material	DEF material0 Material {
										ambientIntensity	0.2
										diffuseColor	1 0 0
									}

								}

								geometry	Cylinder {
									height	0.03
									radius	0.01
								}

							}

							DEF touch1 TouchSensor {
							}

							DEF code1 Script {
								url	"javascript:
function set_light() {
 value = true;
}

            
"
								eventOut  SFBool value
								eventIn  SFTime set_light
							}
						    ]
					    }
				    }

				    DEF button2 Transform {
					    translation	0.02 0.015 0.05
					    children DEF button2group Group {
						    children [ 
							Shape {
								appearance	Appearance {
									material	DEF material1 Material {
										ambientIntensity	0.2
										diffuseColor	0 0 1
									}

								}

								geometry	Cylinder {
									height	0.03
									radius	0.01
								}

							}

							DEF touch2 TouchSensor {
							}

							DEF code2 Script {
								url	"javascript:
function set_light() {
 value = false;
}

            
"
								eventOut  SFBool value
								eventIn  SFTime set_light
							}
						    ]
					    }
				    }
				]
			}
		    ]
	    }
	]
}
