## Vizthumbnail  Thumb_manish_wrl3841581529376308.jpg
DEF Import_DeskLamp_wrl0 Group {
 children [
  NavigationInfo {
   avatarSize [
    .25 1.6 .75
   ]
   visibilityLimit 0
   speed 1
   headlight TRUE
   type ["EXAMINE"
   "ANY"]
  }
  Viewpoint {
   description "DeskLamp"
   jump TRUE
   fieldOfView 0.785
   position 0 .1 1
   orientation 0 0 1 0
  }
  Group {
   children [
    DEF movelamp PlaneSensor {
    }
    DEF lamp Transform {
     children [
      Shape {
       appearance Appearance {
        material DEF color Material {
         ambientIntensity 0.200
         shininess 0.200
         diffuseColor .8 0 .6
        }
       }
       geometry Cylinder {
        height 0.010
        radius 0.100
       }
      }
      Group {
       children [
        DEF movefirstarm SphereSensor {
        }
        DEF firstarm Transform {
         translation 0 .15 0
         rotation 1 0 0 -.7
         center 0 -.15 0
         children [
          DEF lamparm Shape {
           appearance Appearance {
            material USE color
           }
           geometry Cylinder {
            height 0.300
            radius 0.010
           }
          }
          Group {
           children [
            DEF movesecondarm SphereSensor {
            }
            DEF secondarm Transform {
             translation 0 .3 0
             rotation 1 0 0 1.9
             center 0 -.15 0
             children [
              USE lamparm
              Group {
               children [
                DEF movelampshade SphereSensor {
                }
                DEF lampshade Transform {
                 translation 0 .075 0
                 rotation 1 0 0 -1.25
                 center 0 .075 0
                 children [
                  Shape {
                   appearance Appearance {
                    material USE color
                   }
                   geometry Cone {
                    height 0.150
                    bottomRadius 0.120
                    bottom FALSE
                   }
                  }
                  Transform {
                   translation 0 -.05 0
                   children [
                    Shape {
                     appearance Appearance {
                      material DEF color2 Material {
                       ambientIntensity 0.200
                       shininess 0.200
                       diffuseColor .4 .4 .4
                      }
                     }
                     geometry Sphere {
                      radius 0.050
                     }
                    }
                    DEF clock1 TimeSensor {
                     cycleInterval 0.500
                     loop FALSE
                     startTime -1.000
                    }
                    DEF colorpath1 ColorInterpolator {
                     key [
                     0 1
                     ]
                     keyValue [
                     .4 .4 .4
                     1 1 0
                     ]
                    }
                    DEF colorpath2 ColorInterpolator {
                     key [
                     0 1
                     ]
                     keyValue [
                     1 1 0
                     .4 .4 .4
                     ]
                    }
                    DEF clock2 TimeSensor {
                     cycleInterval 0.500
                     loop FALSE
                     startTime -1.000
                    }
                    DEF dad_light Transform {
                     rotation -1 -0 -0 .96
                     children [
                      DEF light SpotLight {
                       ambientIntensity 0.800
                       intensity 1.000
                       radius 20.000
                       cutOffAngle 0.785
                       beamWidth 0.393
                       attenuation 1 0 0
                       color 1 1 0
                       on FALSE
                      }
                     ]
                    }
                   ]
                  }
                 ]
                }
               ]
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      }
      DEF button1 Transform {
       translation -.02 .015 .05
       children [
        DEF button1Group Group {
         children [
          Shape {
           appearance Appearance {
            material DEF material0 Material {
             ambientIntensity 0.200
             shininess 0.200
             diffuseColor 1 0 0
            }
           }
           geometry Cylinder {
            height 0.030
            radius 0.010
           }
          }
          DEF touch1 TouchSensor {
          }
          DEF code1 Script {
            eventOut SFBool value
            eventIn SFTime set_light
           url [ "javascript:
function set_light() {
 value = true;
}

            
" ]
          }
         ]
        }
       ]
      }
      DEF button2 Transform {
       translation .02 .015 .05
       children [
        DEF button2Group Group {
         children [
          Shape {
           appearance Appearance {
            material DEF material1 Material {
             ambientIntensity 0.200
             shininess 0.200
             diffuseColor 0 0 1
            }
           }
           geometry Cylinder {
            height 0.030
            radius 0.010
           }
          }
          DEF touch2 TouchSensor {
          }
          DEF code2 Script {
            eventOut SFBool value
            eventIn SFTime set_light
           url [ "javascript:
function set_light() {
 value = false;
}

            
" ]
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
